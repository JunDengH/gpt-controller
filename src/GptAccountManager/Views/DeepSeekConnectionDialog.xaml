<Window x:Class="GptAccountManager.Views.DeepSeekConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="DeepSeek API 连接"
        Width="548"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Window.Resources>
        <DropShadowEffect x:Key="DialogShadow"
                          BlurRadius="30"
                          Direction="270"
                          Opacity="0.42"
                          ShadowDepth="10"
                          Color="#000000" />
        <Style x:Key="DialogInputStyle" TargetType="Control">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Effect="{StaticResource DialogShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource TitleBarBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="19,19,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="22,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34"
                                    Background="#273E3A"
                                    CornerRadius="17">
                                <iconPacks:PackIconMaterial Width="18" Height="18"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="#61D9C3"
                                                            Kind="Api" />
                            </Border>
                            <TextBlock Margin="11,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="DeepSeek API 连接" />
                        </StackPanel>
                        <Button Grid.Column="1" Width="38" Height="38" MinHeight="38"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="Cancel_Click" ToolTip="关闭">
                            <iconPacks:PackIconMaterial Width="18" Height="18" Kind="Close" />
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="28,24,28,26">
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="连接名称" />
                    <TextBox x:Name="NicknameTextBox"
                             Margin="0,9,0,18"
                             MaxLength="40"
                             Style="{StaticResource DialogInputStyle}"
                             TextChanged="Input_Changed" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="API Key" />
                        <Button Grid.Column="1" Padding="8,2" MinHeight="26"
                                Click="OpenApiKeys_Click" Content="创建 Key" />
                    </Grid>
                    <PasswordBox x:Name="ApiKeyPasswordBox"
                                 Margin="0,9,0,0"
                                 Style="{StaticResource DialogInputStyle}"
                                 PasswordChanged="Input_Changed" />
                    <TextBlock x:Name="KeyHintText"
                               Margin="2,6,0,18"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11.5"
                               Text="Key 仅使用 Windows DPAPI 加密保存在当前用户账户下。" />

                    <Border Padding="14" Background="#252D2C" CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Width="19" Height="19"
                                                        Foreground="#61D9C3" Kind="RobotOutline" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontWeight="SemiBold" Text="deepseek-v4-flash · Responses API" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Text="保存时先验证余额。切换连接会重启 ChatGPT；不同认证组的历史只会暂时隐藏，不会被删除。" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11.5"
                                   Text="Codex 0.146.0 或更高版本" />
                        <Button Grid.Column="1" Width="92" MinHeight="42" Margin="0,0,10,0"
                                IsCancel="True" Click="Cancel_Click" Content="取消" />
                        <Button x:Name="SaveButton" Grid.Column="2" Width="112" MinHeight="42"
                                IsDefault="True" Click="Save_Click"
                                Content="验证并保存"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
