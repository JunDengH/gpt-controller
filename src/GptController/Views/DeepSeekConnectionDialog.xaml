<Window x:Class="GptController.Views.DeepSeekConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="DeepSeek API 连接"
        Width="548"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Grid Margin="28">
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Effect="{StaticResource DialogShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource TitleBarBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="19,19,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="22,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34"
                                    Background="{StaticResource DeepSeekTintBrush}"
                                    CornerRadius="17">
                                <iconPacks:PackIconMaterial Width="18" Height="18"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource DeepSeekAccentBrush}"
                                                            Kind="Api" />
                            </Border>
                            <TextBlock Margin="11,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="DeepSeek API 连接" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource DialogCloseButtonStyle}"
                                AutomationProperties.Name="关闭 DeepSeek 连接弹窗"
                                Click="Cancel_Click" ToolTip="关闭">
                            <iconPacks:PackIconMaterial Width="18" Height="18" Kind="Close" />
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="{StaticResource DialogBodyMargin}">
                    <TextBlock x:Name="NicknameLabel"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="连接名称" />
                    <TextBox x:Name="NicknameTextBox"
                             Margin="0,9,0,18"
                             MaxLength="40"
                             AutomationProperties.IsRequiredForForm="True"
                             AutomationProperties.LabeledBy="{Binding ElementName=NicknameLabel}"
                             AutomationProperties.HelpText="必填。设置一个便于识别的连接名称，最多 40 个字符。"
                             Style="{StaticResource DialogTextBoxStyle}"
                             TextChanged="Input_Changed" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ApiKeyLabel"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="API Key" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SmallGhostButtonStyle}"
                                AutomationProperties.HelpText="在浏览器中打开 DeepSeek API Key 管理页面"
                                Click="OpenApiKeys_Click" Content="创建 Key" />
                    </Grid>
                    <PasswordBox x:Name="ApiKeyPasswordBox"
                                 Margin="0,9,0,0"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ApiKeyLabel}"
                                 AutomationProperties.HelpText="{Binding Text, ElementName=KeyHintText}"
                                 Style="{StaticResource DialogPasswordBoxStyle}"
                                 PasswordChanged="Input_Changed" />
                    <TextBlock x:Name="KeyHintText"
                               Margin="2,6,0,18"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11.5"
                               Text="Key 仅使用 Windows DPAPI 加密保存在当前用户账户下。" />

                    <Border Padding="14"
                            Background="{StaticResource DeepSeekTintBrush}"
                            CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Width="19" Height="19"
                                                        Foreground="{StaticResource DeepSeekAccentBrush}"
                                                        Kind="RobotOutline" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock FontWeight="SemiBold" Text="deepseek-v4-flash · Responses API" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Text="保存时先验证余额。切换连接会重启 ChatGPT；不同认证组的历史只会暂时隐藏，不会被删除。" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11.5"
                                   Text="Codex 0.146.0 或更高版本" />
                        <Button Grid.Column="1" Width="92" MinHeight="42" Margin="0,0,10,0"
                                IsCancel="True" Click="Cancel_Click" Content="取消" />
                        <Button x:Name="SaveButton" Grid.Column="2" Width="112" MinHeight="42"
                                IsDefault="True" Click="Save_Click"
                                AutomationProperties.HelpText="填写必填项后，验证 API Key 和余额并安全保存连接"
                                Content="验证并保存"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
