                                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Button.Style>
                                                                                    <iconPacks:PackIconMaterial Width="17"
                                                                                                                Height="17"
                                                                                                                Kind="SwapHorizontal" />
                                                                                </Button>
                                                                                <Button
                                                                                        IsEnabled="False"
