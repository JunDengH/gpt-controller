<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:converters="clr-namespace:GptController.Converters" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="GptController.Views.MainWindow" Title="GPT Controller" Width="1280" Height="900" MinWidth="960" MinHeight="680" Icon="pack://application:,,,/Assets/AppIcon.ico" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" StateChanged="Window_StateChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <converters:AdaptiveSizeConverter x:Key="AdaptiveSize"/>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='13,16'}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='18,21'}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="CardShell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Key="LedgerPrimaryButton" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#09261C"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimarySurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimarySurface" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PrimarySurface" Property="BorderBrush" Value="{StaticResource FocusRingBrush}"/>
                                <Setter TargetName="PrimarySurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimarySurface" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimarySurface" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LedgerSwitchButton" TargetType="Button" BasedOn="{StaticResource LedgerPrimaryButton}">
            <Setter Property="Content" Value="切换连接"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="FontSize" Value="19"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Content" Value="正在使用"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ProviderBadge">
            <Border CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChatGpt}" Value="True">
                                <Setter Property="Background" Value="#147B56"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Image Source="{Binding ProviderLogo}" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Margin" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChatGpt}" Value="True">
                                    <Setter Property="Margin" Value="8"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" GlassFrameThickness="0" ResizeBorderThickness="7" NonClientFrameEdges="None" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <Border x:Name="TitleBarFrame" Background="{StaticResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="Minimize_Click" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="最小化" Height="30">
                        <icons:PackIconMaterial Kind="WindowMinimize" Width="14" Height="14"/>
                    </Button>
                    <Button Click="MaximizeRestore_Click" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="最大化或还原" Height="30">
                        <icons:PackIconMaterial x:Name="MaximizeIcon" Kind="WindowMaximize" Width="14" Height="14"/>
                    </Button>
                    <Button Click="Close_Click" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="关闭" Height="30">
                        <icons:PackIconMaterial Kind="Close" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Background="{StaticResource TitleBarBrush}">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,34,0">
                        <Border Background="#16875E" CornerRadius="10" Width="40" Height="40">
                            <Image Source="pack://application:,,,/Assets/AppIcon.png" Margin="6"/>
                        </Border>
                        <TextBlock Text="GPT Controller" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='17,22'}" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ShowAccountsCommand}" AutomationProperties.Name="连接管理" Margin="0,0,10,0" Padding="18,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAccountsPage}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SelectedSurfaceBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconMaterial Kind="LayersOutline" Width="24" Height="24" Margin="0,0,10,0"/>
                                <TextBlock Text="连接" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowSettingsCommand}" AutomationProperties.Name="设置" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconMaterial Kind="CogOutline" Width="23" Height="23" Margin="0,0,10,0"/>
                                <TextBlock Text="设置" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SelectedSurfaceBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshAllCommand}" Style="{StaticResource GhostButton}" AutomationProperties.Name="刷新全部" Padding="10,0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconMaterial Kind="Refresh" Width="24" Height="24" Margin="0,0,8,0"/>
                                <TextBlock Text="同步" FontSize="17"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding LatestSyncText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Margin="0,0,24,0">
                            <Run Text="每 "/>
                            <Run Text="{Binding QuotaRefreshMinutes}"/>
                            <Run Text=" 分钟"/>
                        </TextBlock>
                        <Button Click="AddConnection_Click" Style="{StaticResource LedgerPrimaryButton}" Padding="18,0" Height="48" AutomationProperties.Name="添加连接">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="添加 ChatGPT 账号" Command="{Binding AddAccountCommand}"/>
                                    <MenuItem Header="导入当前 ChatGPT" Command="{Binding ImportCurrentCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="{Binding DeepSeekMenuLabel}" Command="{Binding ConfigureDeepSeekCommand}"/>
                                    <MenuItem Header="{Binding QwenMenuLabel}" Command="{Binding ConfigureQwenCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconMaterial Kind="Plus" Width="24" Height="24" Margin="0,0,10,0" Foreground="#09261C"/>
                                <TextBlock Text="添加连接" FontSize="17" Foreground="#09261C"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="AccountsPage" Grid.Row="2" Visibility="{Binding IsAccountsPage, Converter={StaticResource BoolVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="71*"/>
                    <ColumnDefinition Width="29*" MinWidth="280"/>
                </Grid.ColumnDefinitions>
                <Grid Margin="26,0,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='165,192'}"/>
                        <RowDefinition Height="78"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid DataContext="{Binding CurrentConnection}" Visibility="{Binding DataContext.HasCurrentConnection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" Margin="14,26,0,26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="49*"/>
                                    <ColumnDefinition Width="41*"/>
                                    <ColumnDefinition Width="10*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="当前使用" Style="{StaticResource Heading}" Margin="0,0,0,20"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProviderBadge}" Width="64" Height="64"/>
                                        <StackPanel Grid.Column="1" Margin="24,0,20,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentConnectionTitle}" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='18,26'}" FontWeight="SemiBold"/>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding LedgerIdentity}" Style="{StaticResource Caption}" Margin="0,0,10,0" ToolTip="{Binding LedgerIdentity}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="{StaticResource NeutralBadgeBrush}" Padding="10,4" CornerRadius="14" Visibility="{Binding IsChatGpt, Converter={StaticResource BoolVisibility}}">
                                                    <TextBlock Text="{Binding PlanDisplayName}" Style="{StaticResource Caption}" Margin="0" FontSize="14"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,23,18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FiveHourRemainingText}" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='23,30'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding PrimarySummaryLabel}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                        <ProgressBar Value="{Binding FiveHourRemainingValue, Mode=OneWay}" Maximum="100" Height="8" Margin="0,12,0,0" Visibility="{Binding ShowPrimaryProgress, Converter={StaticResource BoolVisibility}}" Style="{StaticResource RoundedProgressBarStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding WeeklyRemainingText}" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='23,30'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SecondarySummaryLabel}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                        <ProgressBar Value="{Binding WeeklyRemainingValue, Mode=OneWay}" Maximum="100" Height="8" Margin="0,12,0,0" Visibility="{Binding ShowSecondaryProgress, Converter={StaticResource BoolVisibility}}" Style="{StaticResource RoundedProgressBarStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,25,0,0">
                                    <TextBlock Text="下次重置" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding WeeklyResetValueText}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="14,34,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCurrentConnection}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="尚未启用连接" Style="{StaticResource Heading}"/>
                                <TextBlock Text="添加账号或 API，再选择连接查看详情。" Style="{StaticResource Caption}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="所有连接" Style="{StaticResource Heading}"/>
                        <TextBlock Text="{Binding Accounts.Count, StringFormat={}{0} 个}" Style="{StaticResource Muted}" Margin="14,3,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="22,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28*"/>
                            <ColumnDefinition Width="17*"/>
                            <ColumnDefinition Width="38*"/>
                            <ColumnDefinition Width="17*"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="名称 / 身份" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="1" Text="方案 / 模型" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="2" Text="Work / Codex 用量 · 余额" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource Caption}"/>
                    </Grid>
                    <ListBox x:Name="ConnectionLedger" Grid.Row="3" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedConnection, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="连接台账">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" CornerRadius="8" Background="Transparent" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedSurfaceBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="Row" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='96,118'}" Margin="22,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28*"/>
                                        <ColumnDefinition Width="17*"/>
                                        <ColumnDefinition Width="38*"/>
                                        <ColumnDefinition Width="17*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProviderBadge}" Width="52" Height="52"/>
                                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LedgerName}" FontWeight="SemiBold" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='15,20'}"/>
                                            <TextBlock Text="{Binding LedgerIdentity}" Style="{StaticResource Caption}" Margin="0,4,0,0" ToolTip="{Binding LedgerIdentity}"/>
                                            <TextBlock Text="{Binding CompanyDisplayName}" Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="{Binding IsOrganization, Converter={StaticResource BoolVisibility}}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Column="1" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="15" Background="{StaticResource NeutralBadgeBrush}">
                                        <TextBlock Text="{Binding LedgerPlan}" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='12,16'}"/>
                                    </Border>
                                    <Grid Grid.Column="2" Margin="0,0,22,0" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding LedgerPrimaryValue}" FontWeight="SemiBold" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='16,20'}" Visibility="{Binding IsApiProvider, Converter={StaticResource BoolVisibility}}"/>
                                                <TextBlock Text="CNY 余额" Style="{StaticResource Caption}" Visibility="{Binding IsApiProvider, Converter={StaticResource BoolVisibility}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding LedgerSecondaryValue}" FontWeight="SemiBold" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='16,20'}" Visibility="{Binding IsApiProvider, Converter={StaticResource BoolVisibility}}"/>
                                                <TextBlock Text="USD 余额" Style="{StaticResource Caption}" Visibility="{Binding IsApiProvider, Converter={StaticResource BoolVisibility}}"/>
                                            </StackPanel>
                                            <Grid Grid.ColumnSpan="3" Visibility="{Binding IsChatGpt, Converter={StaticResource BoolVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding LedgerPrimaryLabel}" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding LedgerPrimaryValue}" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='14,19'}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <ProgressBar Value="{Binding FiveHourRemainingValue, Mode=OneWay}" Visibility="{Binding ShowPrimaryProgress, Converter={StaticResource BoolVisibility}}" Maximum="100" Height="7" Margin="0,9,0,0" Style="{StaticResource RoundedProgressBarStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding LedgerSecondaryLabel}" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding LedgerSecondaryValue}" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='14,19'}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <ProgressBar Value="{Binding WeeklyRemainingValue, Mode=OneWay}" Visibility="{Binding ShowSecondaryProgress, Converter={StaticResource BoolVisibility}}" Maximum="100" Height="7" Margin="0,9,0,0" Style="{StaticResource RoundedProgressBarStyle}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding LedgerResetText}" Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="{Binding IsChatGpt, Converter={StaticResource BoolVisibility}}"/>
                                    </Grid>
                                    <Border Grid.Column="3" Padding="8,5" CornerRadius="15" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SelectedSurfaceBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SelectedSurfaceBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='12,16'}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="未使用"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="当前使用"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                                <Condition Binding="{Binding IsActive}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="已选择"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <icons:PackIconMaterial Grid.Column="4" Kind="ChevronRight" Width="20" Height="20" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="3" Text="添加或导入连接，开始管理账号与官方模型。" TextWrapping="Wrap" Margin="20,24">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasConnections}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Border Grid.Column="1" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1,0,0,0" Background="{StaticResource SurfaceBrush}">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ConnectionInspector" DataContext="{Binding SelectedConnection}" Margin="28,50,28,20" Visibility="{Binding DataContext.HasSelectedConnection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProviderBadge}" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='52,74'}" Height="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='52,74'}"/>
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                        <TextBlock x:Name="InspectorTitle" Text="{Binding LedgerName}" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='18,28'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding LedgerIdentity}" Style="{StaticResource Caption}" Margin="0,6,0,8" ToolTip="{Binding LedgerIdentity}"/>
                                        <TextBlock Text="{Binding DetailKind}" Foreground="{StaticResource AccentBrush}" FontSize="15"/>
                                            <TextBlock Text="{Binding CompanyDisplayName}" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="{Binding IsOrganization, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding CompanyDisplayName}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Width="28" MinHeight="28" Height="28" Padding="0" VerticalAlignment="Top" Click="AddConnection_Click" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="所选连接操作" ToolTip="所选连接操作">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="同步所选连接" Command="{Binding RefreshAccountCommand}" CommandParameter="{Binding SelectedConnection}"/>
                                                <MenuItem Header="删除所选连接" Command="{Binding DeleteAccountCommand}" CommandParameter="{Binding SelectedConnection}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <icons:PackIconMaterial xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Kind="DotsHorizontal" Width="22" Height="22"/>
                                    </Button>
                                </Grid>
                                <StackPanel Margin="0,48,0,0">
                                    <TextBlock Text="余额 / 额度" Style="{StaticResource Heading}" Margin="0,0,0,20"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FiveHourRemainingText}" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='22,40'}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PrimaryMetricDetailText}" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderSubtleBrush}"/>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding WeeklyRemainingText}" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='22,40'}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SecondaryMetricDetailText}" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="0,40,0,0" Visibility="{Binding IsApiProvider, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="当前模型" Style="{StaticResource Heading}" Margin="0,0,0,14"/>
                                    <Button Style="{StaticResource RoundedButtonStyle}" MinHeight="54" Padding="18,0" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.SelectApiModelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="选择官方模型">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ApiPresentation.Model}" FontSize="17" VerticalAlignment="Center" ToolTip="{Binding ApiPresentation.Model}"/>
                                            <icons:PackIconMaterial Kind="ChevronDown" Grid.Column="1" Width="22" Height="22" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <TextBlock Text="{Binding OfficialModelCount, StringFormat={}{0} 个模型可用}" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,30,0,0" Visibility="{Binding IsChatGpt, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="{Binding PlanDisplayName}" Style="{StaticResource Heading}" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding CreditBalanceText}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <Button Style="{StaticResource LedgerSwitchButton}" Margin="0,36,0,0" Command="{Binding DataContext.SwitchAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="切换所选连接" Foreground="#09261C">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <icons:PackIconMaterial Kind="SwapHorizontal" Width="24" Height="24" Foreground="#09261C" Margin="0,0,10,0"/><TextBlock Text="{Binding}" FontSize="20" FontWeight="SemiBold" Foreground="#09261C"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,34,0,30"/>
                                <TextBlock Text="连接信息" Style="{StaticResource Heading}" Margin="0,0,0,22"/>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="类型" Style="{StaticResource Caption}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DetailKind}" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='13,16'}" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="方案 / 模型" Style="{StaticResource Caption}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LedgerPlan}" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='13,16'}" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="最后同步" Style="{StaticResource Caption}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DetailUpdatedText}" FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSize}, ConverterParameter='13,16'}" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,20">
                                    <TextBlock Text="自动同步" Style="{StaticResource Caption}"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="16">
                                        <Run Text="每 "/>
                                        <Run Text="{Binding DataContext.QuotaRefreshMinutes, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Run Text=" 分钟"/>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding QuotaStatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding AccountMetadataStatusText}" Foreground="{StaticResource WarningAccentBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Text="选择连接查看详情" Margin="28,50,28,0" VerticalAlignment="Top" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedConnection}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="2" Margin="32,30,32,0" x:Name="SettingsPage" Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="应用设置" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="按你的节奏同步数据，安排窗口行为。" Style="{StaticResource Caption}" Margin="0,7,0,24"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,20">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardShell}" Padding="24">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,90,0">
                                        <TextBlock Text="自动同步" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="套餐、使用额度、DeepSeek 余额及第三方模型列表" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18" Foreground="{StaticResource AccentBrush}">
                                        <Run Text="{Binding QuotaRefreshMinutes}"/>
                                        <Run Text=" 分钟"/>
                                    </TextBlock>
                                </Grid>
                                <Slider Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding QuotaRefreshMinutes}" Margin="0,26,0,12" AutomationProperties.Name="自动刷新间隔" AutomationProperties.HelpText="范围为 1 到 120 分钟"/>
                                <Grid>
                                    <TextBlock Text="1 分钟" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="120 分钟" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="默认每 2 分钟同步，启动后立即获取。操作进行中会等待结束再刷新；登录失效的账号需要重新登录。" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,22,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardShell}" Padding="24">
                            <StackPanel>
                                <TextBlock Text="窗口与托盘" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,22"/>
                                <CheckBox IsChecked="{Binding CloseToTray}" Style="{StaticResource ToggleSwitchStyle}" AutomationProperties.Name="关闭窗口时保留托盘" Content="关闭窗口时保留托盘"/>
                                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,20"/>
                                <CheckBox IsChecked="{Binding StartMinimized}" Style="{StaticResource ToggleSwitchStyle}" AutomationProperties.Name="启动后直接进入托盘" Content="启动后直接进入托盘"/>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="保存设置" HorizontalAlignment="Right" MinWidth="112" Margin="0,4,0,24" AutomationProperties.Name="保存设置"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="3" Background="{StaticResource TitleBarBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="24,0">
                <Grid>
                    <TextBlock Text="本地加密存储" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="700" AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Top" Visibility="{Binding IsWorking, Converter={StaticResource BoolVisibility}}" Style="{StaticResource RoundedProgressBarStyle}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
