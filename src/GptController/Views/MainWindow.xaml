                                                                    <Run Text="{Binding AccountIdentitySeparator, Mode=OneWay}" />
                                                                    <Run Foreground="{StaticResource TextMutedBrush}"
                                                                         FontSize="11.5"
                                                                         Text="{Binding CompanyDisplayName, Mode=OneWay}" />
                                                                </TextBlock>

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                    <Button Margin="0,0,5,0"
                                                                            CommandParameter="{Binding}"
                                                                            AutomationProperties.Name="{Binding Email, StringFormat='切换到账号 {0}'}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button"
                                                                                   BasedOn="{StaticResource CompactCardActionButtonStyle}">
                                                                                <Setter Property="Command"
                                                                                        Value="{Binding DataContext.SwitchAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                                <Setter Property="ToolTip" Value="切换账号" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                        <Setter Property="Command" Value="{x:Null}" />
                                                                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                                                        <Setter Property="Foreground" Value="White" />
                                                                                        <Setter Property="Cursor" Value="Arrow" />
                                                                                        <Setter Property="ToolTip" Value="当前账号" />
                                                                                        <Setter Property="AutomationProperties.ItemStatus" Value="当前账号" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                        <iconPacks:PackIconMaterial Width="15" Height="15">
                                                                            <iconPacks:PackIconMaterial.Style>
                                                                                <Style TargetType="iconPacks:PackIconMaterial">
                                                                                    <Setter Property="Kind" Value="SwapHorizontal" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                            <Setter Property="Kind" Value="Check" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </iconPacks:PackIconMaterial.Style>
                                                                        </iconPacks:PackIconMaterial>
                                                                    </Button>
                                                                    <Button Margin="0,0,5,0"
                                                                            Command="{Binding DataContext.RefreshAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            AutomationProperties.Name="{Binding Email, StringFormat='刷新账号 {0}'}"
                                                                            Style="{StaticResource CompactCardActionButtonStyle}"
                                                                            ToolTip="刷新额度">
                                                                        <iconPacks:PackIconMaterial Width="15" Height="15" Kind="Refresh" />
                                                                    </Button>
                                                                    <Button Foreground="{StaticResource DangerBrush}"
                                                                            Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            IsEnabled="{Binding CanDelete}"
                                                                            AutomationProperties.Name="{Binding Email, StringFormat='删除账号 {0}'}"
                                                                            Style="{StaticResource CompactCardActionButtonStyle}"
                                                                            ToolTip="删除账号">
                                                                        <iconPacks:PackIconMaterial Width="15" Height="15" Kind="DeleteOutline" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>

                                                            <Grid Grid.Row="2" Margin="0,9,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Margin="0,0,14,0"
                                                                        Padding="2,0"
                                                                        Background="Transparent"
                                                                        CornerRadius="0">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Grid>
                                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       FontSize="9"
                                                                                       Text="5 小时" />
                                                                            <TextBlock HorizontalAlignment="Right"
                                                                                       FontSize="12"
                                                                                       FontWeight="SemiBold"
                                                                                       Text="{Binding FiveHourRemainingText}" />
                                                                        </Grid>
                                                                        <ProgressBar Grid.Row="1"
                                                                                     Height="3"
                                                                                     Margin="0,3,0,0"
                                                                                     Foreground="{StaticResource AccentBrush}"
                                                                                     Maximum="100"
                                                                                     Value="{Binding FiveHourRemainingValue, Mode=OneWay}" />
                                                                        <TextBlock Grid.Row="2"
                                                                                   Margin="0,2,0,0"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   FontSize="8.5"
                                                                                   Text="{Binding PrimaryMetricDetailText}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding PrimaryMetricDetailText}" />
                                                                    </Grid>
                                                                </Border>
                                                                <Border Grid.Column="1"
                                                                        Margin="0"
                                                                        Padding="2,0"
                                                                        Background="Transparent"
                                                                        CornerRadius="0">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                            <RowDefinition Height="Auto" />
                                                                        </Grid.RowDefinitions>
                                                                        <Grid>
                                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       FontSize="9"
                                                                                       Text="每周" />
                                                                            <TextBlock HorizontalAlignment="Right"
                                                                                       FontSize="12"
                                                                                       FontWeight="SemiBold"
                                                                                       Text="{Binding WeeklyRemainingText}" />
                                                                        </Grid>
                                                                        <ProgressBar Grid.Row="1"
                                                                                     Height="3"
                                                                                     Margin="0,3,0,0"
                                                                                     Foreground="{StaticResource AccentBrush}"
                                                                                     Maximum="100"
                                                                                     Value="{Binding WeeklyRemainingValue, Mode=OneWay}" />
                                                                        <TextBlock Grid.Row="2"
                                                                                   Margin="0,2,0,0"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   FontSize="8.5"
                                                                                   Text="{Binding SecondaryMetricDetailText}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding SecondaryMetricDetailText}" />
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>

                                                            <TextBlock Grid.Row="3"
                                                                       Margin="0,3,0,0"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       FontSize="8.5"
                                                                       Text="{Binding QuotaUpdatedValueText, StringFormat=更新 {0}}"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <views:SelectionTraceBorder Grid.RowSpan="5"
                                                                                        Margin="-13,-10"
                                                                                        IsHitTestVisible="False"
                                                                                        IsSelected="{Binding IsActive}"
                                                                                        Stroke="{Binding Background, ElementName=AccountAccentStripe}"
                                                                                        StrokeThickness="2"
                                                                                        CornerRadius="7" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Margin="2,0,2,12"
                                                Padding="20,34"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="18">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChatGptAccounts.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <iconPacks:PackIconMaterial Width="32"
                                                                            Height="32"
                                                                            HorizontalAlignment="Center"
                                                                            Foreground="{StaticResource TextMutedBrush}"
                                                                            Kind="AccountPlusOutline" />
                                                <TextBlock Margin="0,12,0,0"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="还没有 ChatGPT 账号" />
                                                <TextBlock Margin="0,5,0,0"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"
                                                           Text="通过 OAuth 添加，或导入当前登录态" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Width="1"
                                            Margin="15,0"
                                            HorizontalAlignment="Center"
                                            Background="{StaticResource BorderSubtleBrush}" />

                                    <StackPanel Grid.Column="2">
                                        <Grid Margin="2,0,2,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="34"
                                                        Height="34"
                                                        Margin="0,0,10,0"
                                                        Background="{StaticResource DeepSeekTintBrush}"
                                                        BorderBrush="{StaticResource DeepSeekAccentBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="11">
                                                    <iconPacks:PackIconMaterial Width="19"
                                                                                Height="19"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                Foreground="{StaticResource DeepSeekAccentBrush}"
                                                                                Kind="CodeTags" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Text="模型 API" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Padding="9,4"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource NeutralBadgeBrush}"
                                                    CornerRadius="9">
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10.5">
                                                    <Run Text="{Binding ApiConnections.Count, Mode=OneWay}" />
                                                    <Run Text=" 个 API" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding ApiConnections}"
                                                      HorizontalContentAlignment="Stretch">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="120"
                                                            Margin="2,0,2,10"
                                                            Padding="12,9"
                                                            Background="{StaticResource SurfaceBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Effect="{StaticResource CardShadow}"
                                                            AutomationProperties.Name="{Binding ProviderDisplayName}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                                                        <Setter Property="Effect" Value="{StaticResource ActiveCardShadow}" />
                                                                        <Setter Property="AutomationProperties.ItemStatus" Value="当前 API 连接" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>

                                                            <Border x:Name="ApiAccentStripe"
                                                                    Grid.RowSpan="4"
                                                                    Width="2"
                                                                    Margin="-12,-9,0,-9"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{StaticResource DeepSeekAccentBrush}"
                                                                    CornerRadius="7,0,0,7"
                                                                    IsHitTestVisible="False">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0"
                                                                            VerticalAlignment="Center"
                                                                            Orientation="Horizontal">
                                                                    <TextBlock VerticalAlignment="Center"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               FontSize="12.5"
                                                                               FontWeight="SemiBold"
                                                                               Text="{Binding ProviderDisplayName}" />
                                                                </StackPanel>

                                                                <Button Grid.Column="1"
                                                                        Margin="16,0,10,0"
                                                                        Padding="9,4"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        Command="{Binding DataContext.SelectApiModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        AutomationProperties.Name="{Binding ProviderDisplayName, StringFormat='选择 {0} 模型'}"
                                                                        Style="{StaticResource CompactModelButtonStyle}"
                                                                        ToolTip="选择默认模型">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock MaxWidth="190"
                                                                                   VerticalAlignment="Center"
                                                                                   FontWeight="SemiBold"
                                                                                   Text="{Binding ApiModelDisplayName}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <iconPacks:PackIconMaterial Width="14" Height="14"
                                                                                                    Margin="6,0,0,0"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Kind="ChevronDown" />
                                                                    </StackPanel>
                                                                </Button>

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                    <Button Margin="0,0,5,0"
                                                                            CommandParameter="{Binding}"
                                                                            AutomationProperties.Name="{Binding ProviderDisplayName, StringFormat='切换到 API 连接 {0}'}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button"
                                                                                   BasedOn="{StaticResource CompactCardActionButtonStyle}">
                                                                                <Setter Property="Command"
                                                                                        Value="{Binding DataContext.SwitchAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                                <Setter Property="ToolTip" Value="设为当前连接" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                        <Setter Property="Command" Value="{x:Null}" />
                                                                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                                                        <Setter Property="Foreground" Value="White" />
                                                                                        <Setter Property="Cursor" Value="Arrow" />
                                                                                        <Setter Property="ToolTip" Value="当前连接" />
                                                                                        <Setter Property="AutomationProperties.ItemStatus" Value="当前连接" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                        <iconPacks:PackIconMaterial Width="15" Height="15">
                                                                            <iconPacks:PackIconMaterial.Style>
                                                                                <Style TargetType="iconPacks:PackIconMaterial">
                                                                                    <Setter Property="Kind" Value="SwapHorizontal" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                            <Setter Property="Kind" Value="Check" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </iconPacks:PackIconMaterial.Style>
                                                                        </iconPacks:PackIconMaterial>
                                                                    </Button>
                                                                    <Button Margin="0,0,5,0"
                                                                            Command="{Binding DataContext.RefreshAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            AutomationProperties.Name="{Binding ProviderDisplayName, StringFormat='刷新 API 连接 {0}'}"
                                                                            Style="{StaticResource CompactCardActionButtonStyle}"
                                                                            ToolTip="{Binding RefreshToolTip}">
                                                                        <iconPacks:PackIconMaterial Width="15" Height="15" Kind="Refresh" />
                                                                    </Button>
                                                                    <Button Foreground="{StaticResource DangerBrush}"
                                                                            Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            IsEnabled="{Binding CanDelete}"
                                                                            AutomationProperties.Name="{Binding ProviderDisplayName, StringFormat='删除 API 连接 {0}'}"
                                                                            Style="{StaticResource CompactCardActionButtonStyle}"
                                                                            ToolTip="删除连接">
                                                                        <iconPacks:PackIconMaterial Width="15" Height="15" Kind="DeleteOutline" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>

                                                            <Grid Grid.Row="2" Margin="2,13,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10.5"
                                                                           Text="{Binding ApiPresentation.PrimaryMetric.Label}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding ApiPresentation.PrimaryMetric.ValueText}" />
                                                                <Border Grid.Column="2"
                                                                        Width="1"
                                                                        Height="14"
                                                                        Margin="18,0"
                                                                        VerticalAlignment="Center"
                                                                        Background="{StaticResource BorderSubtleBrush}" />
                                                                <StackPanel Grid.Column="3"
                                                                            VerticalAlignment="Center"
                                                                            Orientation="Horizontal">
                                                                    <TextBlock VerticalAlignment="Center"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               FontSize="10.5"
                                                                               Text="模型 ID" />
                                                                    <TextBlock Margin="8,0,0,0"
                                                                               VerticalAlignment="Center"
                                                                               FontSize="10.5"
                                                                               FontWeight="SemiBold"
                                                                               Text="{Binding ApiPresentation.Model}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding ApiPresentation.Model}" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <views:SelectionTraceBorder Grid.RowSpan="4"
                                                                                        Margin="-13,-10"
                                                                                        IsHitTestVisible="False"
                                                                                        IsSelected="{Binding IsActive}"
                                                                                        Stroke="{Binding Background, ElementName=ApiAccentStripe}"
                                                                                        StrokeThickness="2"
                                                                                        CornerRadius="7" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Margin="2,0,2,12"
                                                Padding="20,34"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="18">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ApiConnections.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <iconPacks:PackIconMaterial Width="32"
                                                                            Height="32"
                                                                            HorizontalAlignment="Center"
                                                                            Foreground="{StaticResource TextMutedBrush}"
                                                                            Kind="CodeTags" />
                                                <TextBlock Margin="0,12,0,0"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="还没有模型 API" />
                                                <TextBlock Margin="0,5,0,0"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"
                                                           Text="配置 DeepSeek 或千问 API 后可选择默认模型" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <Grid x:Name="SettingsPage">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid Margin="18,42,32,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='25,29'}"
                                           FontWeight="SemiBold"
                                           Text="设置" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='12,14'}"
                                           Text="管理连接数据刷新频率和窗口行为" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          Margin="0,36,0,0"
                                          HorizontalContentAlignment="Stretch"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource ViewportContentWidthConverter}, ConverterParameter=18}"
                                            MaxWidth="1400"
                                            HorizontalAlignment="Left">
                                    <Grid>
                                        <Border Background="{StaticResource SurfaceBrush}"
                                                CornerRadius="20"
                                                Effect="{StaticResource CardShadow}"
                                                IsHitTestVisible="False" />
                                        <Border Padding="26"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="20">
                                            <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="44"
                                                        Height="44"
                                                        Background="{StaticResource SurfaceRaisedBrush}"
                                                        CornerRadius="22">
                                                    <iconPacks:PackIconMaterial Width="21"
                                                                                Height="21"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                                                Kind="Refresh" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                    <TextBlock FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='15,17'}"
                                                               FontWeight="SemiBold"
                                                               Text="连接数据自动刷新" />
                                                    <TextBlock Margin="0,5,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='12,14'}"
                                                               Text="按所选周期依次刷新所有已保存连接" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='13,15'}"
                                                           FontWeight="SemiBold">
                                                    <Run Text="{Binding QuotaRefreshMinutes}" />
                                                    <Run Text=" 分钟" />
                                                </TextBlock>
                                            </Grid>

                                            <Slider Margin="4,24,4,0"
                                                     AutomationProperties.Name="连接数据自动刷新周期"
                                                     AutomationProperties.HelpText="设置自动刷新间隔，范围为 5 到 120 分钟"
                                                     Minimum="5"
                                                    Maximum="120"
                                                    TickFrequency="5"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding QuotaRefreshMinutes}" />
                                            <Grid Margin="4,8,4,0">
                                                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='10.5,12'}"
                                                           Text="5 分钟" />
                                                <TextBlock HorizontalAlignment="Right"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='10.5,12'}"
                                                           Text="120 分钟" />
                                            </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Border Background="{StaticResource SurfaceBrush}"
                                                CornerRadius="20"
                                                Effect="{StaticResource CardShadow}"
                                                IsHitTestVisible="False" />
                                        <Border Padding="26"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="20">
                                            <StackPanel>
                                            <TextBlock FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='15,17'}"
                                                       FontWeight="SemiBold"
                                                       Text="窗口行为" />
                                            <TextBlock Margin="0,6,0,24"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='12,14'}"
                                                       Text="控制主窗口关闭和启动时的显示方式" />

                                            <CheckBox AutomationProperties.Name="关闭窗口时最小化到托盘"
                                                      AutomationProperties.HelpText="启用后关闭主窗口仍可从托盘重新打开或退出应用"
                                                      IsChecked="{Binding CloseToTray}"
                                                      Style="{StaticResource ToggleSwitchStyle}">
                                                <StackPanel>
                                                    <TextBlock FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='13,15'}"
                                                               Text="关闭窗口时最小化到托盘" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='10.5,12'}"
                                                               Text="仍可从托盘重新打开或退出应用" />
                                                </StackPanel>
                                            </CheckBox>

                                            <Border Height="1"
                                                    Margin="0,24"
                                                    Background="{StaticResource BorderSubtleBrush}" />

                                            <CheckBox AutomationProperties.Name="启动后直接进入托盘"
                                                      AutomationProperties.HelpText="启用后下次启动应用会直接进入系统托盘"
                                                      IsChecked="{Binding StartMinimized}"
                                                      Style="{StaticResource ToggleSwitchStyle}">
                                                <StackPanel>
                                                    <TextBlock FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='13,15'}"
                                                               Text="启动后直接进入托盘" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='10.5,12'}"
                                                               Text="下次启动应用时生效" />
                                                </StackPanel>
                                            </CheckBox>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="2,22,2,30">
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='10.5,12'}">
                                            <Run Text="GPT Controller v" /><Run Text="{Binding ApplicationVersion, Mode=OneWay}" /><Run Text=" · 本地优先 · 无遥测" />
                                        </TextBlock>
                                        <Button HorizontalAlignment="Right"
                                                AutomationProperties.Name="保存设置"
                                                AutomationProperties.HelpText="保存连接数据刷新周期和窗口行为设置"
                                                Command="{Binding SaveSettingsCommand}"
                                                Style="{StaticResource ResponsivePrimaryButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Width="20"
                                                                            Height="20"
                                                                            Margin="0,0,8,0"
                                                                            Kind="ContentSaveOutline" />
                                                <TextBlock Text="保存设置" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Border x:Name="FooterFrame"
                    Grid.Row="2"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0">
                <Grid Margin="30,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Width="20"
                                                    Height="20"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Kind="ShieldCheckOutline" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='11.5,13'}"
                                   Text="所有凭据仅保存在此设备上" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <ProgressBar Width="80"
                                     Height="4"
                                     Margin="0,0,12,0"
                                     AutomationProperties.Name="后台操作进行中"
                                     AutomationProperties.HelpText="GPT Controller 正在处理当前请求"
                                     IsIndeterminate="True">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar"
                                       BasedOn="{StaticResource RoundedProgressBarStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock MaxWidth="560"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='11,12.5'}"
                                   AutomationProperties.Name="{Binding StatusMessage}"
                                   AutomationProperties.HelpText="应用操作状态"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding StatusMessage}"
                                   ToolTip="{Binding StatusMessage}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
