<Window x:Class="GptController.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:GptController.Converters"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewModels="clr-namespace:GptController.ViewModels"
        xmlns:views="clr-namespace:GptController.Views"
        mc:Ignorable="d"
        Title="GPT Controller"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="680"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <converters:AdaptiveSizeConverter x:Key="AdaptiveSizeConverter" />
        <converters:ResponsiveCardHeightConverter x:Key="ResponsiveCardHeightConverter" />
        <converters:ResponsiveCardWidthConverter x:Key="ResponsiveCardWidthConverter" />
        <converters:ViewportContentWidthConverter x:Key="ViewportContentWidthConverter" />

        <Style TargetType="Button"
               BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="MinHeight"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='40,44'}" />
            <Setter Property="FontSize"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='12,14'}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="ResponsivePrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinHeight"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='40,44'}" />
            <Setter Property="FontSize"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='12,14'}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="ResponsiveCardActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Height"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='40,42'}" />
            <Setter Property="MinHeight"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='40,42'}" />
            <Setter Property="FontSize"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='11,14'}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="ApiCardIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="ApiCardTestButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="ApiLedgerLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='11,13.5'}" />
        </Style>

        <Style x:Key="ApiLedgerValueStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='12,14.5'}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ApiLedgerIconStyle"
               TargetType="iconPacks:PackIconMaterial">
            <Setter Property="Width"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='18,22'}" />
            <Setter Property="Height"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='18,22'}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="72"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            NonClientFrameEdges="None"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame"
            Background="{StaticResource BackgroundBrush}"
            BorderThickness="0"
            CornerRadius="0"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBarFrame"
                    Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="22,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Width="36"
                               Height="36"
                               Source="pack://application:,,,/Assets/AppIcon.png"
                               Stretch="Uniform" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='15,17'}"
                                   FontWeight="SemiBold"
                                   Text="GPT Controller" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="0,0,12,0"
                            Padding="12,7"
                            VerticalAlignment="Center"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11.5"
                                   Text="{Binding CurrentProviderText}" />
                    </Border>

                    <StackPanel Grid.Column="2"
                                 Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="Minimize_Click"
                                AutomationProperties.Name="最小化窗口"
                                AutomationProperties.HelpText="将 GPT Controller 最小化到任务栏"
                                ToolTip="最小化">
                            <iconPacks:PackIconMaterial Width="18"
                                                        Height="18"
                                                        Kind="WindowMinimize" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="MaximizeRestore_Click"
                                AutomationProperties.Name="最大化或还原窗口"
                                AutomationProperties.HelpText="在最大化和普通窗口大小之间切换"
                                ToolTip="最大化或还原">
                            <iconPacks:PackIconMaterial x:Name="MaximizeIcon"
                                                        Width="18"
                                                        Height="18"
                                                        Kind="WindowMaximize" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="Close_Click"
                                AutomationProperties.Name="关闭窗口"
                                AutomationProperties.HelpText="关闭窗口；启用托盘模式时会隐藏到系统托盘"
                                ToolTip="关闭">
                            <iconPacks:PackIconMaterial Width="18"
                                                        Height="18"
                                                        Kind="WindowClose" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="116" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <StackPanel Margin="0,54,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                        <Border Width="58"
                                Height="58"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="29"
                                ToolTip="GPT Controller">
                            <Image Width="38"
                                   Height="38"
                                   Source="pack://application:,,,/Assets/AppIcon.png"
                                   Stretch="Uniform" />
                        </Border>

                        <Border Width="60"
                                Height="148"
                                Margin="0,44,0,0"
                                Padding="0,12"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="30">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0"
                                        Command="{Binding ShowAccountsCommand}"
                                        AutomationProperties.Name="连接管理"
                                        AutomationProperties.HelpText="打开连接管理页面"
                                        ToolTip="连接">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource NavIconButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAccountsPage}"
                                                             Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SelectedSurfaceBrush}" />
                                                    <Setter Property="Effect"
                                                            Value="{StaticResource NavSelectionShadow}" />
                                                    <Setter Property="AutomationProperties.ItemStatus"
                                                            Value="当前页面" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <iconPacks:PackIconMaterial Width="23"
                                                                Height="23"
                                                                Kind="AccountOutline" />
                                </Button>

                                <Button Grid.Row="1"
                                        Command="{Binding ShowSettingsCommand}"
                                        AutomationProperties.Name="设置"
                                        AutomationProperties.HelpText="打开设置页面"
                                        ToolTip="设置">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource NavIconButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSettingsPage}"
                                                             Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SelectedSurfaceBrush}" />
                                                    <Setter Property="Effect"
                                                            Value="{StaticResource NavSelectionShadow}" />
                                                    <Setter Property="AutomationProperties.ItemStatus"
                                                            Value="当前页面" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <iconPacks:PackIconMaterial Width="24"
                                                                Height="24"
                                                                Kind="CogOutline" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid x:Name="AccountsPage">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAccountsPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid Margin="18,42,32,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='25,29'}"
                                               FontWeight="SemiBold"
                                               Text="连接管理" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='12,14'}"
                                               Text="统一管理 ChatGPT 账号与模型 API 连接" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='126,146'}"
                                            MinHeight="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='40,44'}"
                                            Margin="0,0,12,0"
                                            AutomationProperties.Name="刷新全部连接"
                                            AutomationProperties.HelpText="刷新所有连接的状态、额度与余额信息"
                                            Command="{Binding RefreshAllCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Width="20"
                                                                        Height="20"
                                                                        Margin="0,0,8,0"
                                                                        Kind="Refresh" />
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='12,14'}"
                                                       Text="刷新全部" />
                                        </StackPanel>
                                    </Button>
                                    <Button Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='138,158'}"
                                             MinHeight="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='40,44'}"
                                             AutomationProperties.Name="添加连接"
                                             AutomationProperties.HelpText="选择添加 ChatGPT OAuth、导入当前 ChatGPT 或配置模型 API"
                                             Click="AddConnection_Click"
                                             Style="{StaticResource ResponsivePrimaryButtonStyle}">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="添加 ChatGPT OAuth"
                                                          Command="{Binding AddAccountCommand}" />
                                                <MenuItem Header="导入当前 ChatGPT"
                                                          Command="{Binding ImportCurrentCommand}" />
                                                <Separator />
                                                <MenuItem Header="{Binding DeepSeekMenuLabel}"
                                                          Command="{Binding ConfigureDeepSeekCommand}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Width="21"
                                                                        Height="21"
                                                                        Margin="0,0,8,0"
                                                                        Kind="Plus" />
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='12,14'}"
                                                       Text="添加连接" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          Margin="0,44,0,0"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <ItemsControl Margin="-8,0,0,0"
                                                  VerticalAlignment="Top"
                                                  ItemsSource="{Binding Accounts}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Accounts.Count}"
                                                                 Value="0">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ResponsiveCardWidthConverter}}"
                                                           ItemHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource ResponsiveCardHeightConverter}}"
                                                           Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="HorizontalAlignment"
                                                        Value="Stretch" />
                                                <Setter Property="VerticalAlignment"
                                                        Value="Stretch" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplateSelector>
                                            <views:ConnectionCardTemplateSelector>
                                                <views:ConnectionCardTemplateSelector.OAuthTemplate>
                                                    <DataTemplate>
                                                <GroupBox Margin="8"
                                                          Focusable="False"
                                                          IsTabStop="False"
                                                          AutomationProperties.Name="{Binding Nickname}"
                                                          AutomationProperties.HelpText="{Binding ProviderDisplayName, StringFormat=提供商：{0}}">
                                                    <GroupBox.Style>
                                                        <Style TargetType="GroupBox">
                                                            <Setter Property="AutomationProperties.ItemStatus"
                                                                    Value="非当前连接" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="GroupBox">
                                                                        <ContentPresenter />
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}"
                                                                             Value="True">
                                                                    <Setter Property="AutomationProperties.ItemStatus"
                                                                            Value="当前活动连接" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </GroupBox.Style>
                                                    <Grid>
                                                        <Border Background="{StaticResource SurfaceBrush}"
                                                                CornerRadius="20"
                                                                IsHitTestVisible="False">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Effect"
                                                                        Value="{StaticResource CardShadow}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}"
                                                                                 Value="True">
                                                                        <Setter Property="Effect"
                                                                                Value="{StaticResource ActiveCardShadow}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <Border Padding="22,16,22,12"
                                                            Background="{StaticResource SurfaceBrush}"
                                                            CornerRadius="20">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush"
                                                                    Value="{StaticResource BorderBrush}" />
                                                            <Setter Property="BorderThickness"
                                                                    Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}"
                                                                             Value="True">
                                                                    <Setter Property="BorderBrush"
                                                                            Value="{StaticResource AccentBrush}" />
                                                                    <Setter Property="BorderThickness"
                                                                            Value="2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='42,46'}"
                                                                    Height="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='42,46'}"
                                                                    Background="{StaticResource NeutralStrongBrush}"
                                                                    CornerRadius="23">
                                                                <iconPacks:PackIconMaterial Width="24"
                                                                                            Height="24"
                                                                                            HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Center"
                                                                                            Foreground="{StaticResource TextPrimaryBrush}"
                                                                                            Kind="AccountOutline" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1"
                                                                       Margin="14,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='18,21'}"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Nickname}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="2"
                                                                    Margin="10,0,0,0"
                                                                    Padding="8,3"
                                                                    VerticalAlignment="Center"
                                                                    Background="{StaticResource NeutralBadgeBrush}"
                                                                    CornerRadius="9">
                                                                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                                           FontSize="10.5"
                                                                           Text="{Binding ProviderDisplayName}" />
                                                            </Border>
                                                        </Grid>

                                                        <Grid Grid.Row="1" Margin="0,12,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="22"
                                                                  Height="22"
                                                                  HorizontalAlignment="Left">
                                                                <iconPacks:PackIconMaterial Width="19"
                                                                                            Height="19"
                                                                                            Foreground="{StaticResource AccentBrush}"
                                                                                            Kind="Check">
                                                                    <iconPacks:PackIconMaterial.Style>
                                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActive}"
                                                                                             Value="True">
                                                                                    <Setter Property="Visibility"
                                                                                            Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </iconPacks:PackIconMaterial.Style>
                                                                </iconPacks:PackIconMaterial>
                                                                <iconPacks:PackIconMaterial Width="19"
                                                                                            Height="19"
                                                                                            Foreground="{StaticResource TextSecondaryBrush}"
                                                                                            Kind="EmailOutline">
                                                                    <iconPacks:PackIconMaterial.Style>
                                                                        <Style TargetType="iconPacks:PackIconMaterial">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActive}"
                                                                                             Value="True">
                                                                                    <Setter Property="Visibility"
                                                                                            Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </iconPacks:PackIconMaterial.Style>
                                                                </iconPacks:PackIconMaterial>
                                                            </Grid>
                                                            <TextBlock Grid.Column="1"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='13,16'}"
                                                                       Text="{Binding Email}"
                                                                       ToolTip="{Binding Email}" />
                                                        </Grid>

                                                        <Grid Grid.Row="2" Margin="0,9,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <iconPacks:PackIconMaterial Width="19"
                                                                                        Height="19"
                                                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                                                        Kind="CrownOutline" />
                                                            <TextBlock Grid.Column="1"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='13,16'}"
                                                                       Text="{Binding PlanDisplayName}" />
                                                        </Grid>

                                                        <Grid Grid.Row="3" Margin="0,9,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="21"
                                                                  Height="21"
                                                                  HorizontalAlignment="Left">
