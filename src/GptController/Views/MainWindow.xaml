<Window x:Class="GptController.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:GptController.Converters"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:GptController.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewModels="clr-namespace:GptController.ViewModels"
        xmlns:views="clr-namespace:GptController.Views"
        mc:Ignorable="d"
        Title="GPT Controller"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="680"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <converters:AdaptiveSizeConverter x:Key="AdaptiveSizeConverter" />
        <converters:ResponsiveCardHeightConverter x:Key="ResponsiveCardHeightConverter" />
        <converters:ResponsiveCardWidthConverter x:Key="ResponsiveCardWidthConverter" />
        <converters:ViewportContentWidthConverter x:Key="ViewportContentWidthConverter" />

        <SolidColorBrush x:Key="PlanProBrush" Color="#5790FF" />
        <SolidColorBrush x:Key="PlanBusinessBrush" Color="#54D1B9" />
        <SolidColorBrush x:Key="PlanPlusBrush" Color="#C469F0" />
        <SolidColorBrush x:Key="PlanDefaultBrush" Color="#F0AE38" />

        <ControlTemplate x:Key="CompactCardButtonTemplate" TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="ButtonBorder"
                            Property="BorderBrush"
                            Value="{StaticResource FocusRingBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="CompactCardActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template" Value="{StaticResource CompactCardButtonTemplate}" />
        </Style>

        <Style x:Key="CompactModelButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template" Value="{StaticResource CompactCardButtonTemplate}" />
        </Style>

        <Style x:Key="AccountPlanIconStyle"
               TargetType="iconPacks:PackIconMaterial">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource PlanDefaultBrush}" />
            <Setter Property="Kind" Value="CrownOutline" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Plus}">
                    <Setter Property="Foreground" Value="{StaticResource PlanPlusBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Pro5x}">
                    <Setter Property="Foreground" Value="{StaticResource PlanProBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Pro20x}">
                    <Setter Property="Foreground" Value="{StaticResource PlanProBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Team}">
                    <Setter Property="Foreground" Value="{StaticResource PlanBusinessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Business}">
                    <Setter Property="Foreground" Value="{StaticResource PlanBusinessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccountPlanTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource PlanDefaultBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Plus}">
                    <Setter Property="Foreground" Value="{StaticResource PlanPlusBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Pro5x}">
                    <Setter Property="Foreground" Value="{StaticResource PlanProBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Pro20x}">
                    <Setter Property="Foreground" Value="{StaticResource PlanProBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Team}">
                    <Setter Property="Foreground" Value="{StaticResource PlanBusinessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Business}">
                    <Setter Property="Foreground" Value="{StaticResource PlanBusinessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccountPlanStripeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PlanDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Plus}">
                    <Setter Property="Background" Value="{StaticResource PlanPlusBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Pro5x}">
                    <Setter Property="Background" Value="{StaticResource PlanProBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Pro20x}">
                    <Setter Property="Background" Value="{StaticResource PlanProBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Team}">
                    <Setter Property="Background" Value="{StaticResource PlanBusinessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Profile.MembershipPlan}"
                             Value="{x:Static models:MembershipPlan.Business}">
                    <Setter Property="Background" Value="{StaticResource PlanBusinessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button"
               BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="MinHeight"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='40,44'}" />
            <Setter Property="FontSize"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='12,14'}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="ResponsivePrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinHeight"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='40,44'}" />
            <Setter Property="FontSize"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='12,14'}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="ResponsiveCardActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CardActionButtonStyle}">
            <Setter Property="Height"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='40,42'}" />
            <Setter Property="MinHeight"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='40,42'}" />
            <Setter Property="FontSize"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='11,14'}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="ApiCardIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="ApiCardTestButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="ApiLedgerLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='11,13.5'}" />
        </Style>

        <Style x:Key="ApiLedgerValueStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='12,14.5'}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ApiLedgerIconStyle"
               TargetType="iconPacks:PackIconMaterial">
            <Setter Property="Width"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='18,22'}" />
            <Setter Property="Height"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='18,22'}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="72"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            NonClientFrameEdges="None"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame"
            Background="{StaticResource BackgroundBrush}"
            BorderThickness="0"
            CornerRadius="0"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBarFrame"
                    Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="22,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Width="36"
                               Height="36"
                               Source="pack://application:,,,/Assets/AppIcon.png"
                               Stretch="Uniform" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='15,17'}"
                                   FontWeight="SemiBold"
                                   Text="GPT Controller" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="0,0,12,0"
                            Padding="12,7"
                            VerticalAlignment="Center"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11.5"
                                   Text="{Binding CurrentProviderText}" />
                    </Border>

                    <StackPanel Grid.Column="2"
                                 Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="Minimize_Click"
                                AutomationProperties.Name="最小化窗口"
                                AutomationProperties.HelpText="将 GPT Controller 最小化到任务栏"
                                ToolTip="最小化">
                            <iconPacks:PackIconMaterial Width="18"
                                                        Height="18"
                                                        Kind="WindowMinimize" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="MaximizeRestore_Click"
                                AutomationProperties.Name="最大化或还原窗口"
                                AutomationProperties.HelpText="在最大化和普通窗口大小之间切换"
                                ToolTip="最大化或还原">
                            <iconPacks:PackIconMaterial x:Name="MaximizeIcon"
                                                        Width="18"
                                                        Height="18"
                                                        Kind="WindowMaximize" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="Close_Click"
                                AutomationProperties.Name="关闭窗口"
                                AutomationProperties.HelpText="关闭窗口；启用托盘模式时会隐藏到系统托盘"
                                ToolTip="关闭">
                            <iconPacks:PackIconMaterial Width="18"
                                                        Height="18"
                                                        Kind="WindowClose" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="116" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <StackPanel Margin="0,54,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                        <Border Width="58"
                                Height="58"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="29"
                                ToolTip="GPT Controller">
                            <Image Width="38"
                                   Height="38"
                                   Source="pack://application:,,,/Assets/AppIcon.png"
                                   Stretch="Uniform" />
                        </Border>

                        <Border Width="60"
                                Height="148"
                                Margin="0,44,0,0"
                                Padding="0,12"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="30">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0"
                                        Command="{Binding ShowAccountsCommand}"
                                        AutomationProperties.Name="连接管理"
                                        AutomationProperties.HelpText="打开连接管理页面"
                                        ToolTip="连接">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource NavIconButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAccountsPage}"
                                                             Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SelectedSurfaceBrush}" />
                                                    <Setter Property="Effect"
                                                            Value="{StaticResource NavSelectionShadow}" />
                                                    <Setter Property="AutomationProperties.ItemStatus"
                                                            Value="当前页面" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <iconPacks:PackIconMaterial Width="23"
                                                                Height="23"
                                                                Kind="AccountOutline" />
                                </Button>

                                <Button Grid.Row="1"
                                        Command="{Binding ShowSettingsCommand}"
                                        AutomationProperties.Name="设置"
                                        AutomationProperties.HelpText="打开设置页面"
                                        ToolTip="设置">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource NavIconButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSettingsPage}"
                                                             Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SelectedSurfaceBrush}" />
                                                    <Setter Property="Effect"
                                                            Value="{StaticResource NavSelectionShadow}" />
                                                    <Setter Property="AutomationProperties.ItemStatus"
                                                            Value="当前页面" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <iconPacks:PackIconMaterial Width="24"
                                                                Height="24"
                                                                Kind="CogOutline" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid x:Name="AccountsPage">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAccountsPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid Margin="18,34,32,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='25,29'}"
                                               FontWeight="SemiBold"
                                               Text="连接管理" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='116,140'}"
                                            Margin="0,0,10,0"
                                            AutomationProperties.Name="刷新全部连接"
                                            AutomationProperties.HelpText="刷新所有账号额度与 API 余额"
                                            Command="{Binding RefreshAllCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Width="18"
                                                                        Height="18"
                                                                        Margin="0,0,7,0"
                                                                        Kind="Refresh" />
                                            <TextBlock VerticalAlignment="Center" Text="刷新全部" />
                                        </StackPanel>
                                    </Button>
                                    <Button Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AdaptiveSizeConverter}, ConverterParameter='126,152'}"
                                            AutomationProperties.Name="添加连接"
                                            AutomationProperties.HelpText="添加 ChatGPT 账号或配置模型 API"
                                            Click="AddConnection_Click"
                                            Style="{StaticResource ResponsivePrimaryButtonStyle}">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="添加 ChatGPT OAuth"
                                                          Command="{Binding AddAccountCommand}" />
                                                <MenuItem Header="导入当前 ChatGPT"
                                                          Command="{Binding ImportCurrentCommand}" />
                                                <Separator />
                                                <MenuItem Header="{Binding DeepSeekMenuLabel}"
                                                          Command="{Binding ConfigureDeepSeekCommand}" />
                                                <MenuItem Header="{Binding QwenMenuLabel}"
                                                          Command="{Binding ConfigureQwenCommand}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Width="20"
                                                                        Height="20"
                                                                        Margin="0,0,7,0"
                                                                        Kind="Plus" />
                                            <TextBlock VerticalAlignment="Center" Text="添加连接" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          Margin="0,28,0,0"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <Grid Margin="0,0,10,26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <Grid Margin="2,0,2,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="34"
                                                        Height="34"
                                                        Margin="0,0,10,0"
                                                        Background="{StaticResource SurfaceRaisedBrush}"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="11">
                                                    <iconPacks:PackIconMaterial Width="19"
                                                                                Height="19"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                Foreground="{StaticResource AccentBrush}"
                                                                                Kind="AccountOutline" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Text="ChatGPT 账号" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Padding="9,4"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource NeutralBadgeBrush}"
                                                    CornerRadius="9">
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="10.5">
                                                    <Run Text="{Binding ChatGptAccounts.Count, Mode=OneWay}" />
                                                    <Run Text=" 个账号" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding ChatGptAccounts}"
                                                      HorizontalContentAlignment="Stretch">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="120"
                                                            Margin="2,0,2,10"
                                                            Padding="12,9"
                                                            Background="{StaticResource SurfaceBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Effect="{StaticResource CardShadow}"
                                                            AutomationProperties.Name="{Binding AccountIdentityDisplayName}"
                                                            AutomationProperties.HelpText="{Binding ProviderDisplayName, StringFormat=账号类型：{0}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                                                        <Setter Property="Effect" Value="{StaticResource ActiveCardShadow}" />
                                                                        <Setter Property="AutomationProperties.ItemStatus" Value="当前账号" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>

                                                            <Border x:Name="AccountAccentStripe"
                                                                    Grid.RowSpan="5"
                                                                    Width="2"
                                                                    Margin="-12,-9,0,-9"
                                                                    HorizontalAlignment="Left"
                                                                    CornerRadius="7,0,0,7"
                                                                    IsHitTestVisible="False"
                                                                    Style="{StaticResource AccountPlanStripeStyle}" />

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0"
