<Window x:Class="GptController.Views.ApiModelSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="选择模型"
        Width="620" Height="610"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Grid Margin="28">
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Effect="{StaticResource DialogShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource TitleBarBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="19,19,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="22,0,14,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="选择 Codex 模型" />
                            <TextBlock x:Name="ProviderNameText"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource DialogCloseButtonStyle}"
                                Click="Cancel_Click" ToolTip="关闭">
                            <iconPacks:PackIconMaterial Width="18" Height="18" Kind="Close" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchTextBox"
                                 MinHeight="40"
                                 Margin="0,0,10,0"
                                 Style="{StaticResource DialogTextBoxStyle}"
                                 TextChanged="Search_Changed"
                                 AutomationProperties.Name="搜索模型" />
                        <Button x:Name="RefreshButton" Grid.Column="1"
                                Width="96" MinHeight="40"
                                Click="Refresh_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="16" Height="16" Margin="0,0,6,0" Kind="Refresh" />
                                <TextBlock Text="重新获取" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="2,8,2,8">
                        <TextBlock x:Name="ResultCountText"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11.5" />
                        <TextBlock x:Name="RefreshStatusText"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ListBox x:Name="ModelsList" Grid.Row="2"
                             Background="{StaticResource SurfaceRaisedBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderSubtleBrush}"
                             BorderThickness="1"
                             Padding="2"
                             SelectionChanged="Selection_Changed"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="{StaticResource SurfaceHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="{StaticResource SelectedSurfaceBrush}" />
                                                    <Setter TargetName="ItemBorder"
                                                            Property="BorderBrush"
                                                            Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="BorderBrush"
                                                            Value="{StaticResource FocusRingBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}" ToolTip="{Binding Id}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,5,0,0"
                                                   Text="{Binding MetadataText}" ToolTip="{Binding MetadataText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Margin="0,0,6,0" Padding="7,2"
                                                Background="{StaticResource InfoTintBrush}"
                                                CornerRadius="7">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="{StaticResource AccentBrush}"
                                                       FontSize="10" Text="当前" />
                                        </Border>
                                        <Border Padding="7,2"
                                                Background="{StaticResource NeutralBadgeBrush}"
                                                CornerRadius="7">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSnapshot}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="10" Text="快照" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="FeeNoticeBorder" Grid.Row="3"
                            Margin="0,12,0,0" Padding="12"
                            Background="{StaticResource DeepSeekTintBrush}"
                            CornerRadius="10">
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Text="应用前会发送一次最小 Responses 兼容性验证，可能产生少量 Token 费用。验证失败不会改变当前模型。" />
                    </Border>
                    <StackPanel Grid.Row="4" Margin="0,16,0,0"
                                HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Width="92" MinHeight="42" Margin="0,0,10,0"
                                IsCancel="True" Click="Cancel_Click" Content="取消" />
                        <Button x:Name="ApplyButton" Width="112" MinHeight="42"
                                IsDefault="True" Click="Apply_Click"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
