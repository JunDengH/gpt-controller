<Window x:Class="GptController.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="编辑昵称"
        Width="476"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Grid Margin="28">
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Effect="{StaticResource DialogShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource TitleBarBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="19,19,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="22,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="34"
                                    Height="34"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="17">
                                <iconPacks:PackIconMaterial Width="17"
                                                            Height="17"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource AccentBrush}"
                                                            Kind="PencilOutline" />
                            </Border>
                            <TextBlock x:Name="DialogTitleText"
                                       Margin="11,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource DialogCloseButtonStyle}"
                                AutomationProperties.Name="关闭编辑昵称弹窗"
                                Click="Cancel_Click"
                                ToolTip="关闭">
                            <iconPacks:PackIconMaterial Width="18"
                                                        Height="18"
                                                        Kind="Close" />
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="{StaticResource DialogBodyMargin}">
                    <TextBlock x:Name="FieldLabelText"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,14"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12.5"
                               Text="设置一个便于识别的名称，账号凭据和登录状态不会改变。" />

                    <TextBox x:Name="ValueTextBox"
                             MaxLength="40"
                             AutomationProperties.IsRequiredForForm="True"
                             AutomationProperties.LabeledBy="{Binding ElementName=FieldLabelText}"
                             AutomationProperties.HelpText="设置一个便于识别的名称，连接凭据和认证状态不会改变。最多 40 个字符。"
                             Style="{StaticResource DialogTextBoxStyle}"
                             TextChanged="ValueTextBox_TextChanged" />

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11.5"
                                   Text="最多 40 个字符" />
                        <Button Grid.Column="1"
                                Width="92"
                                MinHeight="42"
                                Margin="0,0,10,0"
                                IsCancel="True"
                                Click="Cancel_Click"
                                Content="取消" />
                        <Button x:Name="SaveButton"
                                Grid.Column="2"
                                Width="92"
                                MinHeight="42"
                                IsDefault="True"
                                AutomationProperties.HelpText="输入昵称后保存；空白昵称不能保存"
                                Click="Save_Click"
                                Content="保存"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
