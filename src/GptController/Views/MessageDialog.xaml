<Window x:Class="GptController.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="GPT Controller"
        Width="548"
        MaxHeight="680"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="DialogActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,0" />
        </Style>

        <Style x:Key="DialogPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,0" />
        </Style>

        <Style x:Key="DialogDangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource DangerButtonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerButtonBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DangerBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DangerBorder"
                                        Property="Background"
                                        Value="{StaticResource DangerButtonHoverBrush}" />
                                <Setter TargetName="DangerBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource DangerButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="DangerBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource FocusRingBrush}" />
                                <Setter TargetName="DangerBorder"
                                        Property="BorderThickness"
                                        Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DangerBorder"
                                        Property="Opacity"
                                        Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DangerBorder"
                                        Property="Opacity"
                                        Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Effect="{StaticResource DialogShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource TitleBarBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="19,19,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="22,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,12,0"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="IconBackground"
                                    Width="34"
                                    Height="34"
                                    CornerRadius="17">
                                <iconPacks:PackIconMaterial x:Name="DialogIcon"
                                                            Width="17"
                                                            Height="17"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Kind="InformationOutline" />
                            </Border>
                            <TextBlock x:Name="DialogTitleText"
                                       Grid.Column="1"
                                       Margin="11,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Button Grid.Column="1"
                                AutomationProperties.Name="关闭弹窗"
                                Click="Close_Click"
                                Style="{StaticResource DialogCloseButtonStyle}"
                                ToolTip="关闭">
                            <iconPacks:PackIconMaterial Width="18"
                                                        Height="18"
                                                        Kind="Close" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="{StaticResource DialogBodyMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="MessageScrollViewer"
                                  MaxHeight="340"
                                  AutomationProperties.Name="消息内容"
                                  Focusable="True"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsTabStop="True"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="MessageText"
                                   AutomationProperties.LiveSetting="Assertive"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="14"
                                   LineHeight="22"
                                   TextTrimming="None"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="1"
                                Margin="0,25,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="SecondaryButton"
                                Margin="0,0,10,0"
                                Click="Secondary_Click"
                                Style="{StaticResource DialogActionButtonStyle}" />
                        <Button x:Name="PrimaryButton"
                                Click="Primary_Click"
                                Style="{StaticResource DialogPrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
