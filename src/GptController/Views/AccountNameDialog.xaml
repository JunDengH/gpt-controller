<Window x:Class="GptController.Views.AccountNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改账号名称" Width="480" SizeToContent="Height"
        AllowsTransparency="True" Background="Transparent" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="20" Effect="{StaticResource DialogShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource TitleBarBrush}" CornerRadius="19,19,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="22,0,14,0">
                        <TextBlock Text="修改账号名称" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="&#x2715;" Style="{StaticResource DialogCloseButtonStyle}"
                                HorizontalAlignment="Right" Click="Cancel_Click" AutomationProperties.Name="关闭"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="24">
                    <TextBlock Text="账号名称" FontSize="14" Margin="0,0,0,10"/>
                    <TextBox x:Name="NicknameTextBox" MaxLength="40" MinHeight="44"
                             Style="{StaticResource DialogTextBoxStyle}" TextChanged="Nickname_TextChanged"
                             AutomationProperties.Name="账号名称" AutomationProperties.HelpText="必填，最多 40 个字符。"/>
                    <TextBlock Text="最多 40 个字符" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="取消" Width="88" MinHeight="42" Margin="0,0,10,0"
                                IsCancel="True" Click="Cancel_Click"/>
                        <Button x:Name="SaveButton" Content="保存" Width="88" MinHeight="42"
                                IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
